# Read by the process environment. This file is documentation, not auto-loaded.
# SQLite is the default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://procure:password@localhost:5432/procure
# Required with DEPLOYMENT=1. Use an independent random key.
# SECRET_KEY=
# DEPLOYMENT=1
# COOKIE_SECURE=1
# Optional AI: set a model that supports PDF/image input and structured output.
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# PORT=5000
